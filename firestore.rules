rules_version = '2';

// Each player can read and write only their own data.
// Parties: anyone signed in who knows a party's 6-character code can look it up
// and join (if there's room); only members can read the members' weekly
// summaries, and each player can write only their own summary.
// You (the project owner) can see everything in the Firebase console, which is
// not limited by these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /testers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /parties/{code} {
      function isMember() {
        return request.auth.uid in resource.data.members;
      }
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null && (
        // a member renames the party or leaves it
        (isMember()
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.members.size() <= 6)
        ||
        // someone with the code joins: they add only themselves, and there's room
        (!isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() <= 6)
      );

      match /members/{uid} {
        function partyMembers() {
          return get(/databases/$(database)/documents/parties/$(code)).data.members;
        }
        allow read: if request.auth != null && request.auth.uid in partyMembers();
        allow create, update: if request.auth != null && request.auth.uid == uid && request.auth.uid in partyMembers();
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
