rules_version = '2';

// Each player can read and write only their own data.
// You (the project owner) can see every tester's summary in the Firebase console,
// which is not limited by these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /testers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
