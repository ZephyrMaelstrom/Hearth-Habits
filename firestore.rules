rules_version = '2';

// Each player can read and write only their own data. Ember's AI notes are
// written by the hourly job (which uses an admin key and isn't bound by these
// rules) and are read-only for players. ops/* (metrics, AI spend) has no client
// access at all.
// Parties: anyone signed in who knows a party's 6-character code can look it up
// and join (if there's room); only members can read the members' weekly
// summaries, and each player can write only their own summary.
// You (the project owner) can see everything in the Firebase console, which is
// not limited by these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      // saved games (main app and preview)
      match /state/{doc} {
        allow read, write: if owner();
      }
      // this player's devices for push reminders
      match /push/{doc} {
        allow read, write: if owner();
      }
      // what the hourly Ember job wrote (AI plans, reviews): read-only for the player
      match /ai/{doc} {
        allow read: if owner();
      }
    }
    match /testers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // beta feedback: players can send, only the developer (console) can read
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1500;
    }

    // remote tuning and other design data: anyone can read, only the console writes
    match /content/{doc} {
      allow read: if true;
    }

    match /parties/{code} {
      function isMember() {
        return request.auth.uid in resource.data.members;
      }
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null && (
        // a member renames the party or leaves it
        (isMember()
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.members.size() <= 6)
        ||
        // someone with the code joins: they add only themselves, and there's room
        (!isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() <= 6)
      );

      match /members/{uid} {
        function partyMembers() {
          return get(/databases/$(database)/documents/parties/$(code)).data.members;
        }
        allow read: if request.auth != null && request.auth.uid in partyMembers();
        allow create, update: if request.auth != null && request.auth.uid == uid && request.auth.uid in partyMembers();
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
